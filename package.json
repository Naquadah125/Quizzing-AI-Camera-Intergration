{
  "name": "toiyeudoan-exam-platform",
  "version": "1.0.0",
  "description": "Online Examination System with AI Proctoring and Strict Data Isolation",
  "scripts": {
    "server": "npm run dev --prefix backend",
    "client": "npm run dev --prefix frontend",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "seed": "npm run seed --prefix backend",
    "test": "npm run test --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
